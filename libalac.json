{
    "name": "libalac",
    "Format": ["ALAC"],
    "version": "1.0.2",
    "description": "Apple Lossless (ALAC) decoder",
    "filters":["alacdec"],
    "help": "This filter decodes Apple Lossless audio using Apple's reference implementation.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libalac.accessor",
    "filter_source":{
        "alacdec" : "dec_alac.c"
    },
    "extension": {"caf": "audio"},
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "royalty-free",
        "note": "Apple Lossless, opened by Apple",
        "checked": "2026-10-16"
    }
}
